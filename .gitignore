# (scripts/demo/generate_fixtures.py, scripts/demo/export_results.py).
ui/data/private/
# build output of `make public`
dist/
logs/

# Queue runtime state (auto-created by daemon)
queue/state/
queue/logs/

# Model cache
*.cache/

# Editor
.vscode/
.idea/
*.swp

# Local MCP config (generated by scripts/queue/install_mcp.sh — paths are machine-specific)
.mcp.json

