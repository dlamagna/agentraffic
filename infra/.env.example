# =============================================================================
# agentraffic — environment configuration
# =============================================================================
# Copy to infra/.env and fill in your values:
#   cp infra/.env.example infra/.env
#
# The .env file is gitignored — keep secrets out of version control.
# Network topology (subnets, static IPs) lives in infra/network.env.
# =============================================================================

# -----------------------------------------------------------------------------
# Hugging Face authentication (required for gated models such as Llama)
# Get a token at: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=${HF_TOKEN}
HF_HUB_DISABLE_XET=1

# -----------------------------------------------------------------------------
# Deployment mode
#
#   single      All containers share one Docker bridge network.
#               Simple setup; good for quick experiments.
#
#   distributed Separate Docker networks per logical node (agent-a, agent-b,
#               llm), connected via a shared inter-agent bridge.
#               Better for observing cross-service traffic patterns.
#               Requires infra/network.env with subnet/IP assignments.
# -----------------------------------------------------------------------------
DEPLOYMENT_MODE=distributed

# -----------------------------------------------------------------------------
# LLM model & runtime
# -----------------------------------------------------------------------------
# Model used in the paper:
LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# Larger alternatives:
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Token limits — tune based on available VRAM.
# Use scripts/deploy/kv_cache_calc.py to recalculate for your GPU:
#   python scripts/deploy/kv_cache_calc.py --free-gb <FREE_GiB>
LLM_MAX_TOKENS=6144
LLM_MAX_MODEL_LEN=11200
LLM_MAX_NUM_BATCHED_TOKENS=11200
LLM_MAX_NUM_SEQS=8
LLM_DTYPE=float16
LLM_GPU_MEMORY_UTILIZATION=0.70
LLM_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# Network emulation (tc netem)
# Adds artificial latency/jitter/loss to Docker bridge links.
# Only applies in distributed mode. Requires NET_ADMIN capability on containers.
#
# Set ENABLE_NETWORK_EMULATION=1 to activate.
# -----------------------------------------------------------------------------
ENABLE_NETWORK_EMULATION=0

# Delay in milliseconds (e.g. 10ms simulates a local LAN)
NETWORK_DELAY_MS=10

# Jitter in milliseconds (variation around the base delay)
NETWORK_JITTER_MS=2

# Packet loss percentage (0–100)
NETWORK_LOSS_PERCENT=0

# -----------------------------------------------------------------------------
# Agent configuration
# -----------------------------------------------------------------------------
AGENT_B_TIMEOUT_SECONDS=120
MAX_PARALLEL_WORKERS=5

# AgentVerse discussion parameters
FULL_MESH_MAX_ROUNDS=3
DISCUSSION_HISTORY_MAX_CHARS=6000

# -----------------------------------------------------------------------------
# Cost tracking (optional)
# Per-token rates used to annotate each run with an estimated cost.
# Set both to 0 to disable cost estimation.
#
# Reference rates (as of 2026 — prices change frequently):
#   Local vLLM (synthetic):
#     COST_PER_INPUT_TOKEN_USD=0.0000003   # ~$0.30/1M tokens
#     COST_PER_OUTPUT_TOKEN_USD=0.0000006  # ~$0.60/1M tokens
#   GPT-4o:
#     COST_PER_INPUT_TOKEN_USD=0.0000025   # $2.50/1M tokens
#     COST_PER_OUTPUT_TOKEN_USD=0.00001    # $10.00/1M tokens
#   Claude Sonnet 4.6:
#     COST_PER_INPUT_TOKEN_USD=0.000003    # $3.00/1M tokens
#     COST_PER_OUTPUT_TOKEN_USD=0.000015   # $15.00/1M tokens
# -----------------------------------------------------------------------------
COST_PER_INPUT_TOKEN_USD=0
COST_PER_OUTPUT_TOKEN_USD=0

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# Verbose LLM request logging (set to 1 during debugging)
LOG_LLM_REQUESTS=0
LLM_LOG_MAX_CHARS=500

# -----------------------------------------------------------------------------
# Monitoring (Prometheus / Grafana / cAdvisor)
# Enabled by passing --monitoring to scripts/deploy/deploy.sh
# Endpoints when enabled:
#   Grafana:    http://localhost:3001  (admin/admin)
#   Prometheus: http://localhost:9090
#   cAdvisor:   http://localhost:8080
# -----------------------------------------------------------------------------
LLM_METRICS_ENABLED=1
LLM_METRICS_INCLUDE_TOKENS=1
LLM_METRICS_PREFIX=llm
