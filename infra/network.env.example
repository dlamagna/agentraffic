# =============================================================================
# agentraffic — network topology configuration
# =============================================================================
# Copy to infra/network.env:
#   cp infra/network.env.example infra/network.env
#
# Only needed when DEPLOYMENT_MODE=distributed.
# Defines the Docker bridge subnet ranges and static IP assignments
# for each service. The defaults below match the paper's setup.
#
# network.env is gitignored alongside .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Subnet ranges (one per logical node + one shared inter-service bridge)
# -----------------------------------------------------------------------------
NETWORK_AGENT_A_SUBNET=172.20.0.0/24
NETWORK_AGENT_B_SUBNET=172.21.0.0/24
NETWORK_LLM_SUBNET=172.22.0.0/24
NETWORK_INTER_AGENT_SUBNET=172.23.0.0/24

# -----------------------------------------------------------------------------
# Static IP assignments
# Each service gets a home-network IP and an inter-agent bridge IP.
# -----------------------------------------------------------------------------

# Agent A
AGENT_A_IP=172.20.0.10
AGENT_A_INTER_IP=172.23.0.10

# Agent B instances
AGENT_B_IP=172.21.0.10
AGENT_B_INTER_IP=172.23.0.20

AGENT_B_2_IP=172.21.0.11
AGENT_B_2_INTER_IP=172.23.0.21

AGENT_B_3_IP=172.21.0.12
AGENT_B_3_INTER_IP=172.23.0.22

AGENT_B_4_IP=172.21.0.13
AGENT_B_4_INTER_IP=172.23.0.23

# LLM backend
LLM_BACKEND_IP=172.22.0.10
LLM_BACKEND_INTER_IP=172.23.0.30

# Supporting services (on inter-agent bridge only)
CHAT_UI_IP=172.23.0.50
JAEGER_IP=172.23.0.60
